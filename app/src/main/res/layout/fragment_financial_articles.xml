<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pentingnya Menjaga Keuangan Sedini Mungkin"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="16dp"/>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:contentDescription="Ilustrasi perencanaan keuangan"
                    android:scaleType="centerCrop"
                    android:src="@drawable/uang1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Membangun Fondasi Keuangan yang Kuat"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2C3E50"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Memulai perencanaan keuangan sejak dini memungkinkan Anda membangun fondasi yang kuat untuk masa depan. Dengan menabung dan berinvestasi lebih awal, Anda dapat memanfaatkan kekuatan bunga majemuk, yang dapat secara signifikan meningkatkan kekayaan Anda dalam jangka panjang."
                        android:textColor="#34495E"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:contentDescription="Ilustrasi dana darurat"
                    android:scaleType="centerCrop"
                    android:src="@drawable/uang3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pentingnya Dana Darurat"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2C3E50"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Memiliki dana darurat adalah salah satu langkah penting dalam menjaga keuangan. Dana ini dapat melindungi Anda dari situasi tidak terduga seperti kehilangan pekerjaan atau biaya medis yang tidak direncanakan. Idealnya, dana darurat harus mencakup 3-6 bulan pengeluaran hidup Anda."
                        android:textColor="#34495E"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/uang2"
                    android:contentDescription="Ilustrasi penganggaran"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Penganggaran: Kunci Kesuksesan Keuangan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2C3E50"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Membuat dan mematuhi anggaran adalah salah satu kebiasaan keuangan terpenting yang dapat Anda kembangkan. Anggaran membantu Anda melacak pengeluaran, mengidentifikasi area di mana Anda dapat menghemat, dan memastikan bahwa Anda hidup sesuai kemampuan finansial Anda."
                        android:textColor="#34495E"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>